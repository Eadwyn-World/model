{
  "name": "@eadwyn/coordinator",
  "version": "0.1.0",
  "private": true,
  "description": "Coordinator service: node registry, training rounds, the global model version and the public federation readout.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "clean": "rm -rf dist .turbo",
    "test:node": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "cf:types": "wrangler types",
    "cf:dev": "node ../../scripts/ensure-dev-vars.mjs && wrangler d1 migrations apply DB --local && wrangler dev --port 4101 --show-interactive-dev-session=false",
    "cf:check": "wrangler types --check && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@eadwyn/model-registry": "workspace:*",
    "@eadwyn/service-kit": "workspace:*",
    "@eadwyn/shared-protocol": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
