PORT=4105
HOST=0.0.0.0
LOG_FORMAT=pretty
LOG_LEVEL=info
# filesystem: share the Node aggregator's objects directory (local development)
# s3: R2 (or any S3 API) — what the Cloudflare Container uses
OBJECT_STORE=filesystem
OBJECT_STORE_DIR=../aggregator/data/objects
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_DELTAS_BUCKET=eadwyn-deltas
# S3_CHECKPOINTS_BUCKET=eadwyn-checkpoints
# Require `Authorization: Bearer <token>` on jobs.
# MERGE_RUNNER_TOKEN=
