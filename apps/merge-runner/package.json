{
  "name": "@eadwyn/merge-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Merge runner: executes aggregation jobs (FedAvg, median, trimmed mean over safetensors deltas) for merges too large for a Worker. Runs in a Cloudflare Container or on a Pod GPU.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@eadwyn/service-kit": "workspace:*",
    "@eadwyn/shared-protocol": "workspace:*",
    "@eadwyn/weights": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
