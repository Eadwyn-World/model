# Server-side only: where the page reads live federation data from.
COORDINATOR_URL=http://localhost:4101
GOVERNANCE_URL=http://localhost:4103
# auto: try the coordinator, fall back to the built-in snapshot
# mock: always use the snapshot (no network)
# live: only the coordinator (page shows an error state if it is down)
EADWYN_DATA_SOURCE=auto
# Public link used by "Source on GitHub".
NEXT_PUBLIC_SOURCE_URL=https://github.com/Eadwyn-World/model
