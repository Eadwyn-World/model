{
  "name": "@eadwyn/inference-edge",
  "version": "0.1.0",
  "private": true,
  "description": "Inference edge: the public-serving surface. Reports health, the published model it serves, and a mock inference response.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@eadwyn/model-registry": "workspace:*",
    "@eadwyn/service-kit": "workspace:*",
    "@eadwyn/shared-protocol": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
