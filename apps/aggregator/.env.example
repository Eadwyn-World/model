PORT=4102
HOST=0.0.0.0
DATA_DIR=./data
LOG_FORMAT=pretty
LOG_LEVEL=info
# Where to look up node public keys and report round progress.
COORDINATOR_URL=http://localhost:4101
# Where merge candidates are sent for review.
GOVERNANCE_URL=http://localhost:4103
# Verify Ed25519 signatures against the coordinator's node registry. Keep on.
AGGREGATOR_VERIFY_SIGNATURES=true
# Largest delta a node may upload per update (bytes).
AGGREGATOR_MAX_DELTA_BYTES=67108864
