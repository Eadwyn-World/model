# Copy to `.env` inside the app you are running, or export in your shell.
# Every variable has a working default, so a fresh clone runs with no .env at all.

# --- service ports (one per deployable app) ---------------------------------
# apps/coordinator     PORT=4101
# apps/aggregator      PORT=4102
# apps/governance      PORT=4103
# apps/inference-edge  PORT=4104
# apps/web             PORT=3000

# --- service discovery (used by apps and the federation SDK) ----------------
COORDINATOR_URL=http://localhost:4101
AGGREGATOR_URL=http://localhost:4102
GOVERNANCE_URL=http://localhost:4103
INFERENCE_EDGE_URL=http://localhost:4104

# --- persistence -------------------------------------------------------------
# Each service keeps a small JSON state file here (seeded on first run).
DATA_DIR=./data

# --- logging -----------------------------------------------------------------
# pretty | json
LOG_FORMAT=pretty
