{
  "name": "@eadwyn/service-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Small internal toolkit shared by the backend services: JSON file store, env loading, Hono app factory, structured logging.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "clean": "rm -rf .turbo",
    "test:node": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "dependencies": {
    "@eadwyn/shared-protocol": "workspace:*",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "aws4fetch": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
